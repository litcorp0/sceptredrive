{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"root": false,
	"extends": "//",
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**/src/**/*",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.ts",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css"
		]
	},
	"formatter": {
		"indentStyle": "tab"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": ["**/src/components/ui/**"],
			"linter": {
				"rules": {
					"a11y": {
						"useFocusableInteractive": "off",
						"useSemanticElements": "off"
					},
					"correctness": {
						"useExhaustiveDependencies": "off"
					},
					"security": {
						"noDangerouslySetInnerHtml": "off"
					},
					"suspicious": {
						"noArrayIndexKey": "off",
						"noDocumentCookie": "off"
					}
				}
			}
		}
	],
	"linter": {
		"rules": {
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["#/modules/*/*", "#/modules/*/*/**"],
								"message": "Import the module barrel (#/modules/<name>) instead of reaching into its internals."
							},
							{
								"group": ["#/components/auth/**", "#/components/staff/**"],
								"message": "That folder has moved into its module. Import #/modules/<name> instead."
							},
							{
								"group": ["#/components/auth/**"],
								"message": "#/components/auth was deleted in Phase 8; the auth screens live in #/modules/auth."
							}
						]
					}
				}
			}
		}
	}
}
