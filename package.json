{
  "name": "gikautos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "admin",
      "api",
      "packages/*"
    ],
    "catalog": {
      "@better-auth/drizzle-adapter": "1.7.10",
      "@biomejs/biome": "2.4.5",
      "@hono/node-server": "2.1.5",
      "@hono/zod-validator": "0.9.1",
      "@node-rs/argon2": "2.2.2",
      "@types/node": "24.19.2",
      "@types/pg": "8.23.1",
      "better-auth": "1.7.10",
      "dotenv": "18.0.8",
      "drizzle-kit": "0.31.11",
      "drizzle-orm": "0.45.4",
      "hono": "4.13.13",
      "pg": "8.23.1",
      "pino": "10.4.0",
      "pino-pretty": "13.2.0",
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "resend": "6.34.1",
      "tsx": "4.23.0",
      "typescript": "7.0.2",
      "vitest": "5.0.5",
      "zod": "4.6.7"
    }
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:test:prepare": "docker compose exec -T postgres createdb -U gikautos gikautos_test || true && DATABASE_URL=postgresql://gikautos:gikautos@localhost:5433/gikautos_test bun run --filter api db:migrate",
    "dev": "bun run --parallel --if-present --filter '*' dev",
    "dev:api": "bun run --filter api dev",
    "dev:admin": "bun run --filter admin dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check-types": "bun run --if-present --filter '*' check-types",
    "test": "bun run --if-present --filter '*' test",
    "build": "bun run --if-present --filter '*' build",
    "db:generate": "bun run --filter api db:generate",
    "db:migrate": "bun run --filter api db:migrate",
    "db:seed": "bun run --filter api db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:"
  }
}
