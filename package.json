{
  "name": "sceptre-drive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "admin",
      "api",
      "desktop",
      "packages/*"
    ],
    "catalog": {
      "@better-auth/drizzle-adapter": "1.7.10",
      "@biomejs/biome": "2.4.5",
      "@hono/node-server": "2.1.5",
      "@hono/zod-validator": "0.9.1",
      "@node-rs/argon2": "2.2.2",
      "@types/node": "24.19.2",
      "@types/pg": "8.23.1",
      "better-auth": "1.7.10",
      "date-fns": "4.4.0",
      "dotenv": "18.0.8",
      "drizzle-kit": "0.31.11",
      "drizzle-orm": "0.45.4",
      "hono": "4.13.13",
      "libphonenumber-js": "1.13.15",
      "pg": "8.23.1",
      "pg-boss": "12.38.0",
      "pino": "10.4.0",
      "pino-pretty": "13.2.0",
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "resend": "6.34.1",
      "tsx": "4.23.0",
      "typescript": "7.0.2",
      "vitest": "5.0.5",
      "zod": "4.6.7"
    }
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:test:prepare": "docker compose exec -T postgres createdb -U sceptre_drive sceptre_drive_test || true && DATABASE_URL=postgresql://sceptre_drive:sceptre_drive@localhost:$(docker compose port postgres 5432 | cut -d: -f2)/sceptre_drive_test bun run --filter api db:migrate",
    "dev": "bun run --parallel --if-present --filter '*' dev",
    "dev:api": "bun run --filter api dev",
    "dev:admin": "bun run --filter admin dev",
    "dev:pos": "bun run --filter desktop dev",
    "build:pos": "bun run --filter desktop build",
    "package:pos": "bun run --filter desktop package",
    "make:pos": "bun run --filter desktop make",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check-types": "bun run --if-present --filter '*' check-types",
    "test": "bun run --if-present --filter '*' test",
    "build": "bun run --if-present --filter '*' build",
    "db:generate": "bun run --filter api db:generate",
    "db:migrate": "bun run --filter api db:migrate",
    "db:seed": "bun run --filter api db:seed",
    "db:truncate": "bun run api/scripts/truncate-data.ts",
    "seed:admin": "bun run api/scripts/seed-admin.ts",
    "seed:demo-sales": "bun run --filter api seed:demo-sales",
    "sync:init": "docker compose exec -T postgres psql -U sceptre_drive -d sceptre_drive < powersync/init/powersync.sql",
    "sync:up": "bun run scripts/prepare-powersync-service.mjs && docker compose --profile sync up -d powersync",
    "sync:down": "docker compose stop powersync",
    "sync:logs": "docker compose logs -f powersync",
    "sync:config-check": "bun run scripts/check-sync-config.mjs",
    "brand:check": "node scripts/check-brand.mjs",
    "brand:assets": "node scripts/sync-brand-assets.mjs",
    "tokens:check": "node scripts/check-tokens.mjs",
    "modules:check": "node scripts/check-modules.mjs",
    "modules:check:strict": "node scripts/check-modules.mjs --strict && node scripts/check-desktop-modules.mjs --strict",
    "modules:check:pos": "node scripts/check-desktop-modules.mjs",
    "modules:check:pos:strict": "node scripts/check-desktop-modules.mjs --strict"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "yaml": "2.9.1"
  }
}
