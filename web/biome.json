{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"root": false,
	"extends": "//",
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**/src/**/*",
			"**/.vscode/**/*",
			"**/vite.config.ts",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css"
		]
	},
	"formatter": {
		"indentStyle": "tab"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"linter": {
		"rules": {
			"recommended": true
		}
	}
}
