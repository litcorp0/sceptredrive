# Sceptre Drive v1 — environment template. Copy to .env and fill in. Never commit real secrets.

# --- Core ---
NODE_ENV="development"
API_PORT="4000"
API_URL="http://localhost:4000"
ADMIN_URL="http://localhost:3000"
# Local Docker Postgres is mapped to 5433 to avoid clashing with a system Postgres on 5432.
# Phase 7 renamed the project, so the dev database must be
# recreated: `docker compose down -v && docker compose up -d`, then migrate and seed.
DATABASE_URL="postgresql://sceptre_drive:sceptre_drive@localhost:5433/sceptre_drive"
DATABASE_POOL_MAX="10"

# --- Auth (Better Auth) ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:4000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
# Admin :3000, desktop renderer :5173, unpackaged Electron. Development also
# adds these automatically; production must list everything it serves.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,app://sceptre-drive"

# --- Bootstrap admin (seed) ---
# The first admin is created from these values. TOTP setup is forced on first login.
ADMIN_EMAIL="admin@sceptre.local"
ADMIN_PASSWORD=""

# --- Demo seed (development only) ---
# `bun run db:seed --demo` creates the demo branch, terminals, manager, and cashier.
DEMO_MANAGER_EMAIL="manager@sceptre.local"
DEMO_PASSWORD="demo-password-1234"

# --- Staff identifiers ---
# Business-wide sequential staff IDs, e.g. GA-0001.
STAFF_ID_PREFIX="GA"
STAFF_ID_START="1"

# --- PowerSync (POS offline sync) ---
# Local dev can use the self-hosted Docker service; staging/production use PowerSync Cloud.
POWERSYNC_URL="http://localhost:8080"
# HS256 secret used to sign POS sync tokens. Must match the PowerSync client auth key.
POWERSYNC_JWT_SECRET=""
# Must match the PowerSync instance audience (instance URL on Cloud).
POWERSYNC_AUDIENCE="http://localhost:8080"
POWERSYNC_JWT_TTL_SECONDS="3600"

# --- Paystack (Ghana) ---
# `mock` charges nothing and needs no credentials. `test` and `live` refuse to
# boot without PAYSTACK_SECRET_KEY; `live` additionally refuses outside
# NODE_ENV=production.
# Phase 15's go-live checklist fills PAYSTACK_SECRET_KEY,
# PAYSTACK_WEBHOOK_SECRET and PAYSTACK_EMAIL_DOMAIN with the registered
# business's values; PAYSTACK_EMAIL_DOMAIN must be a domain the business owns,
# because the provider may validate deliverability (`.example` will not pass).
# Keep PAYSTACK_MODE=mock until the registered business + keys are ready.
PAYSTACK_MODE="mock"
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""
PAYSTACK_BASE_URL="https://api.paystack.co"
PAYSTACK_EMAIL_DOMAIN="sceptre-drive.example"

# --- Transactional email ---
# Resend in production; console adapter when unset.
RESEND_API_KEY=""
EMAIL_FROM="Sceptre Drive <no-reply@sceptre.local>"

# --- GRA E-VAT ---
# mock until GRA onboarding/credentials are available.
EVAT_PROVIDER="mock"
GRA_EVAT_API_URL=""
GRA_EVAT_API_KEY=""
GRA_EVAT_SIGNATURE_KEY=""

# --- Jobs / workers ---
JOBS_ENABLED="true"

# --- Observability ---
LOG_LEVEL="debug"

# --- Docker Postgres (compose.yaml) ---
# Host port for the compose Postgres. Defaults to 5433; change it when 5433 is
# already taken on the machine.
POSTGRES_PORT="5433"

# --- POS device auth / PowerSync ---
# Instance URL of the PowerSync service. Leave empty to disable sync (the POS
# token endpoint then answers 503 POWERSYNC_NOT_CONFIGURED).
POWERSYNC_URL="http://localhost:8080"
# Must match `client_auth.audience` in powersync/service.yaml.
POWERSYNC_AUDIENCE="http://localhost:8080"
# base64url PKCS8 Ed25519 key for device + PowerSync JWTs.
# Generate with: bun run --filter api keys:generate
# Required in production; development falls back to an ephemeral key.
POS_JWT_PRIVATE_KEY=""
POS_JWT_KEY_ID="pos-v1"
POS_JWT_TTL_SECONDS="900"

# --- Self-hosted PowerSync service (development / CI only) ---
# These feed compose.yaml and powersync/service.yaml (`!env PS_...`).
# Staging and production use PowerSync Cloud instead.
PS_DATA_SOURCE_URI=""
PS_STORAGE_URI=""
PS_JWKS_URI="http://host.docker.internal:4000/.well-known/jwks.json"
# Admin API token for the PowerSync CLI; development only.
PS_ADMIN_TOKEN="dev-powersync-admin-token"

# --- Client build-time variables ---
# Admin (TanStack Start)
VITE_API_URL="http://localhost:4000"
# Desktop POS (Electron renderer)
# Production API/PowerSync origins are not set here: the POS derives them from
# `SCEPTRE_DOMAIN` in desktop/src/main/config.ts, which is the single source of truth.
VITE_APP_ENV="development"
