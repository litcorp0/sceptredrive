# GikAutos v1 — environment template. Copy to .env and fill in. Never commit real secrets.

# --- Core ---
NODE_ENV="development"
API_PORT="4000"
API_URL="http://localhost:4000"
ADMIN_URL="http://localhost:3000"
# Local Docker Postgres is mapped to 5433 to avoid clashing with a system Postgres on 5432.
DATABASE_URL="postgresql://gikautos:gikautos@localhost:5433/gikautos"
DATABASE_POOL_MAX="10"

# --- Auth (Better Auth) ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:4000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# --- Bootstrap admin (seed) ---
# The first admin is created from these values. TOTP setup is forced on first login.
ADMIN_EMAIL="admin@gikautos.local"
ADMIN_PASSWORD=""

# --- Demo seed (development only) ---
# `bun run db:seed --demo` creates the demo branch, terminals, manager, and cashier.
DEMO_MANAGER_EMAIL="manager@gikautos.local"
DEMO_PASSWORD="demo-password-1234"

# --- Staff identifiers ---
# Business-wide sequential staff IDs, e.g. GA-0001.
STAFF_ID_PREFIX="GA"
STAFF_ID_START="1"

# --- PowerSync (POS offline sync) ---
# Local dev can use the self-hosted Docker service; staging/production use PowerSync Cloud.
POWERSYNC_URL="http://localhost:8080"
# HS256 secret used to sign POS sync tokens. Must match the PowerSync client auth key.
POWERSYNC_JWT_SECRET=""
# Must match the PowerSync instance audience (instance URL on Cloud).
POWERSYNC_AUDIENCE="http://localhost:8080"
POWERSYNC_JWT_TTL_SECONDS="3600"

# --- Paystack (Ghana) ---
# Keep PAYSTACK_MODE=mock until the registered business + keys are ready.
PAYSTACK_MODE="mock"
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# --- Transactional email ---
# Resend in production; console adapter when unset.
RESEND_API_KEY=""
EMAIL_FROM="GikAutos <no-reply@gikautos.local>"

# --- GRA E-VAT ---
# mock until GRA onboarding/credentials are available.
EVAT_PROVIDER="mock"
GRA_EVAT_API_URL=""
GRA_EVAT_API_KEY=""
GRA_EVAT_SIGNATURE_KEY=""

# --- Jobs / workers ---
JOBS_ENABLED="true"

# --- Observability ---
LOG_LEVEL="debug"

# --- Client build-time variables ---
# Admin (TanStack Start)
VITE_API_URL="http://localhost:4000"
# Desktop POS (Electron renderer)
VITE_APP_ENV="development"
