# GikAutos v1 — environment template. Copy to .env and fill in. Never commit real secrets.

# --- Core ---
NODE_ENV="development"
API_PORT="4000"
API_URL="http://localhost:4000"
ADMIN_URL="http://localhost:3000"
DATABASE_URL="postgresql://gikautos:gikautos@localhost:5432/gikautos"

# --- Auth (Better Auth) ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:4000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# --- PowerSync (POS offline sync) ---
# Local dev can use the self-hosted Docker service; staging/production use PowerSync Cloud.
POWERSYNC_URL="http://localhost:8080"
# HS256 secret used to sign POS sync tokens. Must match the PowerSync client auth key.
POWERSYNC_JWT_SECRET=""
# Must match the PowerSync instance audience (instance URL on Cloud).
POWERSYNC_AUDIENCE="http://localhost:8080"
POWERSYNC_JWT_TTL_SECONDS="3600"

# --- Paystack (Ghana) ---
# Keep PAYSTACK_MODE=mock until the registered business + keys are ready.
PAYSTACK_MODE="mock"
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# --- Transactional email ---
# Resend in production; console adapter when unset.
RESEND_API_KEY=""
EMAIL_FROM="GikAutos <no-reply@gikautos.local>"

# --- GRA E-VAT ---
# mock until GRA onboarding/credentials are available.
EVAT_PROVIDER="mock"
GRA_EVAT_API_URL=""
GRA_EVAT_API_KEY=""
GRA_EVAT_SIGNATURE_KEY=""

# --- Jobs / workers ---
JOBS_ENABLED="true"

# --- Observability ---
LOG_LEVEL="debug"

# --- Client build-time variables ---
# Admin (TanStack Start)
VITE_API_URL="http://localhost:4000"
# Desktop POS (Electron renderer)
VITE_APP_ENV="development"
