{
  "name": "desktop",
  "productName": "GikAutos POS",
  "version": "0.1.0",
  "private": true,
  "description": "GikAutos offline-first point of sale",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "author": {
    "name": "GikAutos",
    "email": "engineering@gikautos.com"
  },
  "license": "UNLICENSED",
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "scripts": {
    "setup": "node scripts/prepare-desktop.mjs",
    "copy-assets": "powersync-web copy-assets -o public",
    "start": "bun run setup && bun run copy-assets && electron-forge start",
    "dev": "bun run setup && bun run copy-assets && electron-forge start",
    "build": "bun run setup && bun run copy-assets && electron-forge package",
    "package": "bun run setup && bun run copy-assets && electron-forge package",
    "make": "bun run setup && bun run copy-assets && electron-forge make",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "node test/e2e/security-smoke.mjs",
    "test:spike": "node test/e2e/powersync-spike.mjs",
    "test:sync": "node test/e2e/sync-smoke.mjs",
    "test:print": "node test/e2e/print-smoke.mjs"
  },
  "dependencies": {
    "@maxxuxx/node-printer": "1.6.11",
    "@node-rs/argon2": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@sceptre/shared": "workspace:*",
    "@journeyapps/wa-sqlite": "2.0.8",
    "@powersync/react": "2.1.0",
    "@powersync/web": "2.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-virtual": "3.14.22",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "45.0.0",
    "electron-squirrel-startup": "1.0.1",
    "lucide-react": "0.577.0",
    "playwright": "1.64.1",
    "radix-ui": "1.8.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "3.0.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.3.6",
    "typescript": "catalog:",
    "vite": "8.3.5",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
